# Example environment file for running the bot with systemd (TradingView-only build)
# Copy to: /etc/rsi-pi-bot.env  and then:  sudo chmod 600 /etc/rsi-pi-bot.env
#
# Required:
DISCORD_TOKEN=PUT_YOUR_DISCORD_TOKEN_HERE

# NOTE: PYTHONPATH is set by the systemd unit itself (Environment=... in
# deploy/rsi-pi-bot.service). You only need it here if you run the bot from a
# shell instead of systemd:
# PYTHONPATH=/opt/rsi-pi-bot/src

# Recommended: keep runtime data outside the git repo. The systemd unit
# creates /var/lib/rsi-pi-bot and /var/log/rsi-pi-bot automatically
# (StateDirectory/LogsDirectory) with the right ownership.
TICKERS_FILE=/var/lib/rsi-pi-bot/tickers.csv
DB_PATH=/var/lib/rsi-pi-bot/rsi_bot.db
LOG_PATH=/var/log/rsi-pi-bot/rsi_bot.log
